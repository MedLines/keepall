{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "keepall-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Free plan: SQLite-backed Durable Objects only.
  "durable_objects": { "bindings": [{ "name": "CHANNELS", "class_name": "Channel" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Channel"] }],
  // Per IP address, counted separately in each Cloudflare location. Periods can only be 10 or 60 seconds.
  // A 100 MB file is up to 320 frames, so one upload plus its replies fits in a minute's frame budget.
  "ratelimits": [
    { "name": "CONNECTION_LIMIT", "namespace_id": "4101", "simple": { "limit": 60, "period": 60 } },
    { "name": "MESSAGE_LIMIT", "namespace_id": "4102", "simple": { "limit": 600, "period": 60 } }
  ],
  // Served at keepall-relay.<account>.workers.dev. `pnpm run deploy` limits browser connections to www.keepall.app.
  "workers_dev": true,
  "observability": { "enabled": false }
}
