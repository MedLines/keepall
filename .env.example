# Required on Vercel Production and Preview (normalized to URL.origin at runtime).
# Without it, non-local deployments disable service-worker registration and
# persistent-storage requests and show a configuration warning. Preview URLs
# that differ from this value stay usable for testing but skip PWA-only features.
NEXT_PUBLIC_KEEPALL_ORIGIN=https://keepall.app

# Optional Contact delivery. Server-only: never use NEXT_PUBLIC_ for these.
# Leave blank until configured. Restart dev or redeploy after changing them.
# FROM: an address on your Resend-verified sending domain.
# TO: your existing inbox. Visitor replies use their submitted email address.
# See docs/contact-email.md for setup and production rate limiting.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
