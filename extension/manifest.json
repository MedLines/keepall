{
  "manifest_version": 3,
  "name": "Keepall Capture",
  "version": "0.1.0",
  "description": "Save the current page to your local Keepall library.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["activeTab", "scripting", "offscreen", "storage", "alarms"],
  "host_permissions": ["https://www.keepall.app/*", "http://localhost/*"],
  "web_accessible_resources": [{
    "resources": ["inter-latin-wght-normal.woff2"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "background": { "service_worker": "worker.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": {
    "default_title": "Save page to Keepall",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "commands": {
    "open-editor": {
      "suggested_key": "Alt+K",
      "description": "Open Keepall capture on this page"
    }
  }
}
